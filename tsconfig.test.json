{
  "compilerOptions": {
    "target": "ES2016",
    "module": "commonjs", // CommonJS used cause of jest need
    "strict": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/main/ts",
    "outDir": "src/main/js",
    "noEmit": true,
    "types": ["jest", "node"],
    "typeRoots": [
      "src/main/ts/types",
      "node_modules/@types"
    ]
  },
  "include": ["src/main/ts/**/*.ts", "src/test/ts/**/*.ts"]
}
