{
  "compilerOptions": {
    "target": "ES2016",
    "module": "ESNext",
    "strict": true,
    "declaration": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/main/ts",
    "outDir": "src/main/js",
    "types": ["node"],
    "typeRoots": [
      "src/main/ts/types",
      "node_modules/@types"
    ]
  },
  "include": ["src/main/ts/**/*.ts"]
}
