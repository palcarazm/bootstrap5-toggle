{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "strict": true,
    "declaration": true,
    "declarationMap": false,
    "declarationDir": "./src/main/@types",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/main/ts",
    "outDir": "src/main/js",
     "typeRoots": [
      "src/main/ts/types",
      "node_modules/@types"
    ]
  },
  "include": ["src/main/ts/**/*.ts"]
}
