  "repository": {
    "type": "git",
    "url": "https://github.com/palcarazm/bootstrap5-toggle.git"
  },
  "bugs": {
    "url": "https://github.com/palcarazm/bootstrap5-toggle/issues"
  },
  "devDependencies": {
