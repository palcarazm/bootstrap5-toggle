  "type": "module",
  "author": {
    "name": "Pablo Alcaraz Martínez",
    "url": "https://github.com/palcarazm/"
  },
  "description": "Bootstrap Toggle is a bootstrap 5 plugin that converts checkboxes into toggles.",
